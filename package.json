{
  "name": "mri-safety-quickcheck",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "release:ios:version": "npx eas-cli@latest build:version:get -p ios",
    "release:ios:build": "npx eas-cli@latest build -p ios --profile production",
    "release:ios:submit": "npx eas-cli@latest submit -p ios --profile production --latest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
